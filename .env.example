# Copy to .env (gitignored) and fill in only what your experiments use.

# ---- Model providers (agent and judge can use different ones) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# ollama / vllm need no key (vllm: set base_url in the config; custom keys via api_key_env)

# ---- Search backends (the experiment's `search_backend` picks one) ----
EXA_API_KEY=
TAVILY_API_KEY=

# Optional extra blocklist entries (comma-separated substrings of URLs)
AGENT_EVAL_BLOCKLIST=
